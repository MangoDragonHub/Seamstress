<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Interface translations, read by Lang. -->
    <EmbeddedResource Include="Localization\*.json" />
    <!-- The example theme and its notes, copied into the user's Themes folder at startup. -->
    <EmbeddedResource Include="..\..\Themes\*.*" LogicalName="Themes/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

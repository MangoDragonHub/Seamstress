<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Seamstress</AssemblyName>
    <RootNamespace>Seamstress.App</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <QtBridgeAssemblyResourceId>Seamstress</QtBridgeAssemblyResourceId>

    <!-- Qt Bridge for C# ships one package per platform; pick the one for the machine being built on. -->
    <QtBridgePackagePrefix>QtGroup.Qt.Bridge.CSharp</QtBridgePackagePrefix>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == ''"
      >$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</QtBridgeTemplateArch>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == 'X64'">x64</QtBridgeTemplateArch>
    <QtBridgeTemplateArch Condition="'$(QtBridgeTemplateArch)' == 'Arm64'">arm64</QtBridgeTemplateArch>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and '$(RuntimeIdentifier)' != ''"
      >$(RuntimeIdentifier)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('Windows'))"
      >win-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))"
      >linux-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <QtBridgeTemplateRid Condition="'$(QtBridgeTemplateRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))"
      >osx-$(QtBridgeTemplateArch)</QtBridgeTemplateRid>
    <!-- There is no linux-arm64 package. On Linux the bridge compiles the native host from source against the Qt in
         QtDir, and the rest of the linux-x64 package is architecture-neutral (.NET assemblies and C++ headers), so
         that package also serves ARM64 builds, native or cross-compiled. -->
    <QtBridgeTemplateRid Condition="$(QtBridgeTemplateRid.StartsWith('linux-'))">linux-x64</QtBridgeTemplateRid>
    <QtBridgePackageId>$(QtBridgePackagePrefix).$(QtBridgeTemplateRid)</QtBridgePackageId>
  </PropertyGroup>

  <!-- On Linux and macOS the bridge builds against an installed Qt 6. Pass -p:QtDir=<qt prefix> (or set the QtDir
       environment variable); if neither is given, the Qt online-installer / aqt location below is tried. -->
  <PropertyGroup Condition="'$(QtDir)' == '' and '$(OS)' != 'Windows_NT'">
    <QtDir Condition="'$(QtBridgeTemplateArch)' == 'x64' and Exists('$(HOME)/Qt/6.11.3/gcc_64/lib/cmake/Qt6/Qt6Config.cmake')"
      >$(HOME)/Qt/6.11.3/gcc_64</QtDir>
    <QtDir Condition="'$(QtBridgeTemplateArch)' == 'arm64' and Exists('$(HOME)/Qt/6.11.3/gcc_arm64/lib/cmake/Qt6/Qt6Config.cmake')"
      >$(HOME)/Qt/6.11.3/gcc_arm64</QtDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(QtBridgePackageId)" Version="0.4.*-*" />
    <ProjectReference Include="..\Seamstress.Core\Seamstress.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <None Include="*.qml" />
    <QtResource Include="icons/seamstress.svg" />
  </ItemGroup>

  <!-- The bridge generates the native host's main.cpp itself, so the two things it does not offer are patched here.
       First, .NET gets about one second to start, then the host quits with ".NET host not ready after timeout"; a
       Raspberry Pi 4 or an RK3399 board starting from an SD card can need longer, so the limit is raised to 30 seconds
       (the wait still ends as soon as .NET is up or has exited).
       Second, when no .NET 8+ runtime is installed, loadApp fails and runApp then returns 0 without a word, so the
       application closes as if it had run: such a PC gets a dialog with the download link instead.
       The bridge rewrites main.cpp on every build because the edited file differs from what it generates; when the
       edited result is the same as last time, the file gets its old time back so that it is not compiled again. -->
  <Target Name="SeamstressPatchHostMain" AfterTargets="QtBridgeGenerate" BeforeTargets="QtBridgeBuild"
    Condition="'$(QtGenSourceCode)' == 'true' and Exists('$(ProjectQtNativeSourceDir)/cpp/main.cpp')">
    <PropertyGroup>
      <_SeamstressHostMain>$(ProjectQtNativeSourceDir)/cpp/main.cpp</_SeamstressHostMain>
      <_SeamstressHostLast>$(ProjectDir)$(IntermediateOutputPath)seamstress-host-main.cpp</_SeamstressHostLast>
      <_SeamstressHostSource>$([System.IO.File]::ReadAllText('$(_SeamstressHostMain)'))</_SeamstressHostSource>
      <_SeamstressHostLimit>constexpr int maxTries = 10000;</_SeamstressHostLimit>
      <!-- Inserted in front of main, which both the older template (QT_DOTNET_HOST) and the newer one
           (nativeHostAssemblyName) have, so that the definition is present whichever the bridge generates. -->
      <_SeamstressHostMissingDotNet>#ifdef Q_OS_WINDOWS
#include &lt;QDesktopServices&gt;
#include &lt;QUrl&gt;
#include &lt;windows.h&gt;
// No .NET 8+ runtime could be loaded: without this the application would just close without a word.
static void SeamstressMissingDotNet()
{
    if (MessageBoxW(nullptr, L"Seamstress needs the .NET 8 runtime (or newer), which is not installed.\n\n"
        L"Download it now?", L"Seamstress", MB_YESNO | MB_ICONERROR | MB_TASKMODAL) == IDYES)
        QDesktopServices::openUrl(QUrl(QStringLiteral("https://dotnet.microsoft.com/download/dotnet/8.0")));
}
#else
static void SeamstressMissingDotNet() {}
#endif</_SeamstressHostMissingDotNet>
      <!-- The check for the failed host is two lines in the generated file; the 8 spaces on the second line are part
           of what is matched, so both values continue at column 0. -->
      <_SeamstressHostExitCheck>if (dotNetExited)
        return dotNetResult;</_SeamstressHostExitCheck>
      <_SeamstressHostExitCheckFixed>if (dotNetExited)
    {
        if (dotNetResult == -4) SeamstressMissingDotNet();
        return dotNetResult;
    }</_SeamstressHostExitCheckFixed>
    </PropertyGroup>
    <PropertyGroup>
      <_SeamstressHostSource Condition="$(_SeamstressHostSource.Contains('$(_SeamstressHostLimit)'))"
        >$(_SeamstressHostSource.Replace('$(_SeamstressHostLimit)', 'constexpr int maxTries = 300000;'))</_SeamstressHostSource>
      <_SeamstressHostSource Condition="$(_SeamstressHostSource.Contains('dotNetResult = dotNetHost.runApp();'))"
        >$(_SeamstressHostSource.Replace('dotNetResult = dotNetHost.runApp();', 'dotNetResult = dotNetHost.isLoaded() ? dotNetHost.runApp() : -4;'))</_SeamstressHostSource>
      <_SeamstressHostSource Condition="$(_SeamstressHostSource.Contains('$(_SeamstressHostExitCheck)'))"
        >$(_SeamstressHostSource.Replace('$(_SeamstressHostExitCheck)', '$(_SeamstressHostExitCheckFixed)'))</_SeamstressHostSource>
      <_SeamstressHostSource Condition="$(_SeamstressHostSource.Contains('int main')) and !$(_SeamstressHostSource.Contains('static void SeamstressMissingDotNet()'))"
        >$(_SeamstressHostSource.Replace('int main', '$(_SeamstressHostMissingDotNet)

int main'))</_SeamstressHostSource>
    </PropertyGroup>
    <Warning Condition="!$(_SeamstressHostSource.Contains('maxTries = 300000;'))"
      Text="Seamstress: the bridge's generated host changed; its .NET start-up timeout was not raised." />
    <Warning Condition="!$(_SeamstressHostSource.Contains('SeamstressMissingDotNet();'))"
      Text="Seamstress: the bridge's generated host changed; the missing-.NET dialog was not added." />
    <WriteLinesToFile File="$(_SeamstressHostMain)" Overwrite="true"
      Lines="$([MSBuild]::Escape($(_SeamstressHostSource)))" />
    <GetFileHash Files="$(_SeamstressHostMain)">
      <Output TaskParameter="Hash" PropertyName="_SeamstressHostHash" />
    </GetFileHash>
    <GetFileHash Condition="Exists('$(_SeamstressHostLast)')" Files="$(_SeamstressHostLast)">
      <Output TaskParameter="Hash" PropertyName="_SeamstressHostLastHash" />
    </GetFileHash>
    <PropertyGroup>
      <_SeamstressHostUnchanged>false</_SeamstressHostUnchanged>
      <_SeamstressHostUnchanged Condition="'$(_SeamstressHostHash)' == '$(_SeamstressHostLastHash)'">true</_SeamstressHostUnchanged>
    </PropertyGroup>
    <Touch Condition="'$(_SeamstressHostUnchanged)' == 'true'" Files="$(_SeamstressHostMain)"
      Time="$([System.IO.File]::GetLastWriteTime('$(_SeamstressHostLast)').ToString('o'))" />
    <Copy Condition="'$(_SeamstressHostUnchanged)' != 'true'" SourceFiles="$(_SeamstressHostMain)"
      DestinationFiles="$(_SeamstressHostLast)" />
  </Target>

</Project>
